# The site is a React SPA; Laravel only serves /api/*. Without this, Hostinger's
# default DirectoryIndex picks index.php first, so "/" falls through to Laravel's
# leftover welcome route instead of serving the built SPA.
<IfModule mod_dir.c>
    DirectoryIndex index.html index.php
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # One canonical host: www -> apex (301).
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Handle API routes - send to Laravel
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^ index.php [L]

    # Dynamic sitemap from the database (SitemapController); the static
    # sitemap.xml file is only a fallback for local/other hosting.
    RewriteRule ^sitemap\.xml$ index.php [L]

    # "/" has no content of its own; the Indonesian homepage is the x-default.
    # A real 301 (not the SPA's client-side redirect) so Google consolidates it.
    RewriteRule ^$ /id [R=301,L]

    # SEO shells generated at build time (Frontend/scripts/prerender-seo.mjs):
    # same SPA, but with per-page lang/title/description/canonical/hreflang in the
    # raw HTML. Keep this page list in sync with ROUTES in that script.
    RewriteRule ^(id|en|zh)/?$ prerender/$1.html [L]
    RewriteRule ^(id|en|zh)/(tentang-kami|produk|jaringan-distribusi|portofolio|galeri|karir|kontak)/?$ prerender/$1/$2.html [L]

    # Handle React SPA routing - serve index.html for non-file requests (except API)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteRule ^ index.html [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"

    # HTTPS is enforced for the apex domain; tell browsers to remember it.
    # No includeSubDomains/preload on purpose (other subdomains aren't audited here).
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Static-asset caching. These <FilesMatch> rules key off the served file's
# extension, so they never touch /api/* (which is served by index.php) — the
# API's own Cache-Control headers (see ImageController etc.) stay authoritative.
<IfModule mod_headers.c>
    # Vite build output uses content-hashed filenames -> safe to cache forever.
    <FilesMatch "\.(js|mjs|css|woff2|woff|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Images referenced by stable names: long cache, but allow revalidation.
    <FilesMatch "\.(jpe?g|png|webp|avif|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # The SPA shell (index.html + the prerender/*.html SEO shells) must always be
    # revalidated so a new deploy is picked up at once.
    <FilesMatch "(\.html|^manifest\.webmanifest|^sw\.js|^robots\.txt|^sitemap\.xml)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Disable directory browsing
Options -Indexes
