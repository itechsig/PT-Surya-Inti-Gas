APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# SECURITY WARNING: Set APP_DEBUG=false in production to prevent information leakage
APP_DEBUG=true
APP_URL=http://localhost

# CORS Configuration
# Comma-separated list of allowed origins (e.g., https://example.com,https://www.example.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://pt-surya-inti-gas.vercel.app

# Admin IP Whitelist Configuration
# Comma-separated list of allowed IP addresses for admin routes (e.g., 192.168.1.1,10.0.0.1)
# Leave empty to allow all IPs (for development)
ADMIN_ALLOWED_IPS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_username
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

SESSION_DRIVER=database
# SECURITY WARNING: Reduce session lifetime for better security (120 minutes = 2 hours)
# For admin routes, consider implementing shorter sessions
SESSION_LIFETIME=120
# SECURITY WARNING: Set SESSION_ENCRYPT=true in production for better security
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Additional Session Security
SESSION_SECURE_COOKIES=false  # Set to true in production with HTTPS
SESSION_HTTP_ONLY=true        # Prevent JavaScript access to session cookies

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Queue Configuration
QUEUE_FAILED_DRIVER=database
# Queue options: database, redis, sync

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=database
# CACHE_PREFIX=

# Advanced Cache Configuration
CACHE_DEFAULT_TTL=3600
CACHE_LAYERS=memory,redis
CACHE_WARMING_ENABLED=false
CACHE_WARMING_INTERVAL=300
CACHE_COMPRESSION_ENABLED=true
CACHE_COMPRESSION_THRESHOLD=1024

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HR_EMAIL="klinkzsweet@gmail.com"

# Email Verification Configuration
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TIMEOUT=60

# AWS Configuration
# SECURITY WARNING: Never commit real AWS credentials to version control
# Use IAM roles or AWS Secrets Manager in production
AWS_ACCESS_KEY_ID=CHANGE_THIS_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_THIS_AWS_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=your_s3_bucket_name
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gemini AI Configuration
# SECURITY WARNING: Never commit real API keys to version control
# Use environment variables or secret management services in production
GEMINI_API_KEY=CHANGE_THIS_GEMINI_API_KEY
GEMINI_API_KEYS=key1,key2,key3  # Multiple keys for rotation (comma-separated) - CHANGE THESE
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=embedding-001
GEMINI_ROTATION_ENABLED=true
GEMINI_ROTATION_STRATEGY=round_robin  # Options: round_robin, random, least_used
GEMINI_POOL_ENABLED=true
GEMINI_POOL_SIZE=5
GEMINI_TIMEOUT=30
